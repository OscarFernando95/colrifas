---
import content from '../data/content.json';
import { PRIZE_KEYS, PRIZE_LABELS, type Draw, type NextDraw } from '../lib/content';
import { fmtDate, money, pairOf } from '../lib/format';

const draws = content.draws as Draw[];
const nextDraw = content.nextDraw as NextDraw | null;
const visible = draws.length > 0 || !!nextDraw;
---

{visible && (
  <section class="section" id="sorteos" aria-labelledby="sorteos-title">
    <div class="container">
      <div class="section-head">
        <h2 id="sorteos-title" class="h2" data-split>
          {draws.length > 0 ? `${draws.length} ${draws.length === 1 ? 'sorteo realizado' : 'sorteos realizados'}.` : 'Próximo sorteo.'}
        </h2>
        {draws.length > 0 && <p class="lead" data-reveal>Cada resultado, con su evidencia.</p>}
      </div>

      {nextDraw && (
        <article class="next clay" data-reveal>
          <small>Próximo sorteo</small>
          <b>{fmtDate(nextDraw.date)}</b>
          <ul>
            {PRIZE_KEYS.filter((k) => nextDraw.prizes[k]).map((k) => (
              <li><span>{PRIZE_LABELS[k]}</span><strong>{money(nextDraw.prizes[k]!)}</strong></li>
            ))}
          </ul>
          {nextDraw.note && <p>{nextDraw.note}</p>}
        </article>
      )}

      <div class="draws">
        {draws.map((d) => (
          <article class="draw clay">
            <header>
              <b>{fmtDate(d.date)}</b>
              {d.number && <span>Lotería del día: <strong>{d.number}</strong></span>}
            </header>
            {PRIZE_KEYS.some((k) => d.results[k]) && (
              <ul>
                {PRIZE_KEYS.filter((k) => d.results[k]).map((k) => {
                  const r = d.results[k]!;
                  const pair = pairOf(d.number, k);
                  return (
                    <li>
                      <span>{PRIZE_LABELS[k]}{pair && <> · <strong>{pair}</strong></>}</span>
                      <strong>{money(r.prize)}</strong>
                      {r.winner && <em>Ganó: {r.winner}</em>}
                    </li>
                  );
                })}
              </ul>
            )}
            {d.note && <p>{d.note}</p>}
            {d.images.length > 0 && (
              <div class="shots">
                {d.images.map((src) => (
                  <a href={src} target="_blank" rel="noopener noreferrer">
                    <img src={src} alt={`Evidencia del sorteo del ${fmtDate(d.date)}`} loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .next { padding: 24px; display: grid; gap: 8px; margin-bottom: 24px; max-width: 520px; }
  .next small { color: var(--gold-text); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
  .next > b { font-size: 1.6rem; font-family: var(--font-display); }
  .next p { color: var(--muted); }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  li { display: grid; grid-template-columns: 1fr auto; gap: 2px 14px; align-items: baseline; padding-top: 10px; border-top: 1px solid var(--line); }
  li:first-child { border-top: 0; padding-top: 0; }
  li span { color: var(--muted); }
  li strong { font-family: var(--font-display); font-size: 1.1rem; }
  li em { grid-column: 1 / -1; color: var(--muted); font-style: normal; font-size: 0.95rem; overflow-wrap: anywhere; }
  .draws { display: grid; gap: 18px; }
  .draw { padding: 22px; display: grid; gap: 14px; }
  .draw header { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: baseline; }
  .draw header b { font-family: var(--font-display); font-size: 1.25rem; }
  .draw header span, .draw p { color: var(--muted); }
  .shots { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .shots img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 14px; display: block; }
</style>
