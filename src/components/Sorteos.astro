---
import content from '../data/content.json';
import Rail from './Rail.astro';
import { PRIZE_KEYS, PRIZE_LABELS, type Draw, type NextDraw } from '../lib/content';
import { fmtDate, money, pairOf } from '../lib/format';

const draws = content.draws as Draw[];
const total = Math.max((content as { drawsTotal?: number }).drawsTotal ?? draws.length, draws.length);
const nextDraw = content.nextDraw as NextDraw | null;
const visible = draws.length > 0 || !!nextDraw;
const THUMBS = 3;
---

{visible && (
  <section class="section compact" id="sorteos" aria-labelledby="sorteos-title">
    <div class="container">
      <div class="head">
        <h2 id="sorteos-title" class="h2 t" data-split>
          {total > 0 ? `${total} ${total === 1 ? 'sorteo realizado' : 'sorteos realizados'}.` : 'Próximo sorteo.'}
        </h2>
        {draws.length > 0 && (
          <p class="lead" data-reveal>{total > draws.length ? `Los ${draws.length} más recientes, con su evidencia.` : 'Cada resultado, con su evidencia.'}</p>
        )}
      </div>

      <div data-reveal>
        <Rail label="Próximo sorteo y sorteos realizados">
          {nextDraw && (
            <article class="card clay upcoming">
              <header>
                <span class="badge">Próximo sorteo</span>
                <b>{fmtDate(nextDraw.date)}</b>
              </header>
              <ul>
                {PRIZE_KEYS.filter((k) => nextDraw.prizes[k]).map((k) => (
                  <li><span>{PRIZE_LABELS[k]}</span><strong>{money(nextDraw.prizes[k]!)}</strong></li>
                ))}
              </ul>
              {nextDraw.note && <p>{nextDraw.note}</p>}
            </article>
          )}

          {draws.map((d) => (
            <article class="card clay">
              <header>
                <b>{fmtDate(d.date)}</b>
                {d.number && <span class="chip">Lotería <strong>{d.number}</strong></span>}
              </header>
              {PRIZE_KEYS.some((k) => d.results[k]) && (
                <ul>
                  {PRIZE_KEYS.filter((k) => d.results[k]).map((k) => {
                    const r = d.results[k]!;
                    const pair = pairOf(d.number, k);
                    return (
                      <li>
                        <span>{PRIZE_LABELS[k]}{pair && <> · <b>{pair}</b></>}</span>
                        <strong>{money(r.prize)}</strong>
                        {r.winner && <em>Ganó {r.winner}</em>}
                      </li>
                    );
                  })}
                </ul>
              )}
              {d.note && <p>{d.note}</p>}
              {d.images.length > 0 && (
                <div class="shots">
                  {d.images.map((src, i) => (
                    <a
                      href={src}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={{ extra: i >= THUMBS }}
                      data-lightbox={`sorteo-${d.id}`}
                      data-caption={`Sorteo del ${fmtDate(d.date)}`}
                      aria-label={`Ver evidencia ${i + 1} del sorteo del ${fmtDate(d.date)}`}
                    >
                      <img src={src} alt="" loading="lazy" decoding="async" />
                      {i === THUMBS - 1 && d.images.length > THUMBS && <span class="more">+{d.images.length - THUMBS}</span>}
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </Rail>
      </div>
    </div>
  </section>
)}

<style>
  .compact { padding-block: clamp(44px, 6vw, 76px); }
  .head { display: grid; gap: 6px; margin-bottom: 22px; }
  .h2.t { font-size: clamp(1.8rem, 4.2vw, 2.7rem); }
  .head .lead { font-size: 1rem; }

  .card { --card-w: 290px; padding: 16px 18px 18px; display: grid; gap: 10px; align-content: start; border-radius: 22px; }
  .card header { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .card header > b { font-family: var(--font-display); font-size: 1.08rem; letter-spacing: -0.01em; }
  .chip { font-size: 0.78rem; color: var(--gold-text); background: rgba(229, 193, 88, 0.2); padding: 3px 10px; border-radius: 99px; white-space: nowrap; }
  .chip strong { letter-spacing: 0.08em; }
  .badge { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #16161a; background: var(--gold); padding: 3px 10px; border-radius: 99px; }
  .upcoming { box-shadow: var(--clay-shadow), 0 0 0 1.5px var(--gold); }
  .card p { font-size: 0.9rem; color: var(--muted); line-height: 1.4; }

  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 7px; }
  li { display: grid; grid-template-columns: 1fr auto; gap: 0 10px; align-items: baseline; padding-top: 7px; border-top: 1px solid var(--line); font-size: 0.88rem; }
  li:first-child { border-top: 0; padding-top: 0; }
  li span { color: var(--muted); }
  li span b { color: var(--ink); letter-spacing: 0.06em; }
  li strong { font-family: var(--font-display); font-size: 1rem; }
  li em { grid-column: 1 / -1; font-style: normal; font-size: 0.82rem; color: var(--muted); overflow-wrap: anywhere; }

  .shots { display: flex; gap: 8px; }
  .shots a { position: relative; display: block; width: 54px; height: 54px; overflow: hidden; border-radius: 12px; cursor: zoom-in; flex: 0 0 auto; }
  .shots a.extra { display: none; }
  .shots a:focus-visible { outline: 2px solid var(--gold-deep); outline-offset: 2px; }
  .shots img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .more { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(10, 11, 13, 0.55); color: #fff; font-weight: 700; font-size: 0.95rem; }
  @media (hover: hover) { .shots a:hover img { transform: scale(1.1); } }
</style>
