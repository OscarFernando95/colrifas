---
const rules = [
  { title: 'La lotería decide', text: 'Resultado público que cualquiera puede consultar.', icon: 'check' },
  { title: 'Pagos a la vista', text: 'Cada comprobante se publica en el grupo.', icon: 'receipt' },
  { title: 'Gratis y sin amarres', text: 'Entras sin pagar y sales cuando quieras.', icon: 'door' },
  { title: 'Cero datos de más', text: 'Solo pedimos lo necesario para pagarte.', icon: 'lock' },
];
---

<section class="section" id="reglas" aria-labelledby="reglas-title">
  <div class="container">
    <div class="section-head">
      <h2 id="reglas-title" class="h2" data-split>Nadie de COLRIFAS elige al ganador.</h2>
      <p class="lead" data-reveal>Todo sale de la lotería oficial del día. Tú mismo lo puedes comprobar.</p>
    </div>
    <div class="cards" data-stagger>
      {rules.map((r) => (
        <article class="card clay" data-tilt>
          <span class="icon" aria-hidden="true">
            {r.icon === 'check' && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.4 2.4 4.6-5" /></svg>}
            {r.icon === 'receipt' && <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h6M9 12h6M9 16h3" /></svg>}
            {r.icon === 'door' && <svg viewBox="0 0 24 24"><path d="M15 4h4v16h-4" /><path d="M10 8l-4 4 4 4M6 12h10" /></svg>}
            {r.icon === 'lock' && <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>}
          </span>
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards { display: grid; gap: 18px; grid-template-columns: 1fr; }
  @media (min-width: 560px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .cards { grid-template-columns: repeat(4, 1fr); } }
  .card { padding: 28px 24px; display: grid; gap: 12px; align-content: start; transform-style: preserve-3d; }
  .icon {
    width: 56px; height: 56px; border-radius: 18px; display: grid; place-items: center;
    background: linear-gradient(160deg, var(--gold-light), var(--gold) 55%, var(--gold-deep));
    box-shadow: 0 10px 20px -8px rgba(204, 164, 59, 0.7), inset 2px 2px 5px rgba(255, 246, 210, 0.7), inset -3px -3px 7px rgba(125, 95, 23, 0.35);
  }
  .icon svg { width: 26px; height: 26px; stroke: #16161a; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .card h3 { font-size: 1.22rem; font-weight: 600; margin-top: 6px; }
  .card p { color: var(--muted); }
  @media (hover: hover) { .card:hover { box-shadow: var(--clay-shadow-hover); } }
</style>
