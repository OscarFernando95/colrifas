---
import { SITE } from '../data/site';
---

<a
  class="float-wa whatsapp-floating-btn whatsapp-trigger-link"
  id="float-wa"
  href={SITE.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Entrar al grupo de COLRIFAS en WhatsApp"
>
  <svg aria-hidden="true"><use href="#i-wa"></use></svg>
</a>

<style>
  .float-wa {
    position: fixed; z-index: 90; right: clamp(16px, 3vw, 28px); bottom: calc(env(safe-area-inset-bottom, 0px) + 20px);
    width: 60px; height: 60px; border-radius: 22px; display: grid; place-items: center; color: #16161a;
    background: linear-gradient(160deg, var(--gold-light), var(--gold) 50%, var(--gold-deep));
    box-shadow: 0 16px 34px -12px rgba(204, 164, 59, 0.8), inset 3px 3px 7px rgba(255, 246, 210, 0.75), inset -4px -5px 10px rgba(125, 95, 23, 0.35);
    opacity: 0; transform: translateY(24px) scale(0.85); pointer-events: none;
    transition: opacity 0.35s var(--ease-out), transform 0.45s cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  .float-wa svg { width: 28px; height: 28px; fill: currentColor; }
  :global(.float-wa.is-visible) { opacity: 1; transform: none; pointer-events: auto; }
  .float-wa:active { transform: scale(0.94); }
</style>
