---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Términos y condiciones', item: `${SITE.url}/terminos-y-condiciones.html` },
    ],
  },
];

// Texto legal sin cambios respecto a la versión publicada el 17 de septiembre de 2026.
const sections = [
  { t: '1. Objeto', p: 'Estos términos y condiciones regulan el acceso y uso del grupo oficial de WhatsApp de COLRIFAS y la participación en las dinámicas y sorteos en efectivo que allí se publican. Al unirte al grupo o participar en una dinámica, aceptas las condiciones aquí descritas.' },
  { t: '2. Participación', p: 'La participación en el grupo y en las dinámicas es voluntaria y está dirigida a personas mayores de edad, residentes en Colombia. Cada dinámica publica de forma previa sus propias condiciones de participación (costo, si aplica, número de cupos y fecha del sorteo).' },
  { t: '3. Mecánica de los sorteos', p: 'El número o resultado ganador de cada dinámica se determina utilizando los resultados públicos de la lotería del día indicada al momento de publicar la dinámica. COLRIFAS no interviene en la definición de dichos resultados, que son públicos y verificables por cualquier persona.' },
  { t: '4. Entrega de premios', p: 'Una vez definido el resultado, contactamos a la persona ganadora a través de WhatsApp para coordinar la entrega del premio en efectivo. El comprobante de la transferencia se publica en el grupo como constancia del pago. Es responsabilidad del participante mantener sus datos de contacto actualizados dentro del grupo.' },
  { t: '5. Uso del grupo de WhatsApp', p: 'Los integrantes del grupo se comprometen a mantener un trato respetuoso y a no compartir contenido ofensivo, spam o publicidad de terceros. COLRIFAS se reserva el derecho de remover del grupo a cualquier persona que incumpla estas normas de convivencia.' },
  { t: '6. Responsabilidad', p: 'COLRIFAS actúa como organizador de las dinámicas y no se hace responsable por fallas ajenas a su control, como interrupciones del servicio de WhatsApp, errores de digitación del participante o demoras de terceros (bancos o plataformas de pago) en el proceso de transferencia del premio.' },
  { t: '7. Modificaciones', p: 'COLRIFAS podrá actualizar estos términos y condiciones en cualquier momento para reflejar cambios en la operación del grupo o de las dinámicas. La fecha de la última actualización se indica al inicio de esta página.' },
];
---

<Base
  title="Términos y condiciones | COLRIFAS, sorteos en efectivo en Colombia"
  description="Consulta los términos y condiciones de uso del grupo de WhatsApp y de las dinámicas de sorteos en efectivo de COLRIFAS en Colombia."
  path="/terminos-y-condiciones.html"
  jsonLd={jsonLd}
>
  <PageHero
    crumb="Términos y condiciones"
    title="Términos y condiciones."
    lead="Reglas de participación en las dinámicas y el grupo de WhatsApp de COLRIFAS. Última actualización: 17 de septiembre de 2026."
  />
  <section class="section">
    <div class="container narrow">
      <article class="legal glass">
        {sections.map((s) => (
          <section data-reveal>
            <h2>{s.t}</h2>
            <p>{s.p}</p>
          </section>
        ))}
        <section data-reveal>
          <h2>8. Contacto</h2>
          <p>
            Si tienes dudas sobre estos términos, puedes escribirnos directamente en nuestro
            <a href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer" class="whatsapp-trigger-link">grupo oficial de WhatsApp</a>
            o consultar nuestras <a href="/preguntas-frecuentes.html">preguntas frecuentes</a>.
          </p>
        </section>
      </article>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 860px; }
  .legal { border-radius: var(--radius-lg); padding: clamp(24px, 5vw, 56px); display: grid; gap: 34px; }
  .legal h2 { font-size: clamp(1.25rem, 2.4vw, 1.5rem); font-weight: 600; margin-bottom: 10px; }
  .legal p { color: var(--muted); max-width: 68ch; }
  .legal a { color: var(--gold-text); font-weight: 600; }
</style>
