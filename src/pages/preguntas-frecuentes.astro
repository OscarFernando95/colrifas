---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import FinalCta from '../components/FinalCta.astro';
import { FAQS } from '../data/faq';
import { SITE } from '../data/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Preguntas frecuentes', item: `${SITE.url}/preguntas-frecuentes.html` },
    ],
  },
];
---

<Base
  title="Preguntas frecuentes | COLRIFAS, sorteos en efectivo en Colombia"
  description="Resolvemos las dudas más comunes sobre los sorteos en efectivo de COLRIFAS: cuánto cuesta entrar, cómo se elige al ganador, cuándo empieza y cómo se paga."
  path="/preguntas-frecuentes.html"
  jsonLd={jsonLd}
>
  <PageHero
    crumb="Preguntas frecuentes"
    title="Preguntas frecuentes."
    lead="Lo que más nos preguntan sobre los sorteos en efectivo de COLRIFAS."
  />
  <section class="section">
    <div class="container narrow">
      <FaqList items={FAQS} idPrefix="faq" />
    </div>
  </section>
  <FinalCta title="¿Aún tienes dudas? Pregunta en el grupo." micro="Se abre WhatsApp · Te respondemos ahí mismo" />
</Base>

<style>
  .narrow { max-width: 900px; }
</style>
