# Variables del panel /admin. Se configuran en Vercel (Settings → Environment Variables); nunca se suben al repo.
ADMIN_USER=
ADMIN_PASSWORD=          # mínimo 8 caracteres, mejor una frase larga
ADMIN_SECRET=            # texto aleatorio de 32+ caracteres para firmar la sesión
GITHUB_TOKEN=            # token con permiso Contents: Read and write solo sobre este repo
GITHUB_REPO=OscarFernando95/colrifas
GITHUB_BRANCH=main
